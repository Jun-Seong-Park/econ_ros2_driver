<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>econ_ros2_driver</name>
  <version>0.1.0</version>
  <description>
    econ_ros2_driver provides a ROS2 driver for the see3cam with trigger and master
    on jetson platform and PC.     
  </description>
  <maintainer email="jspark2954@aluxonline.com">alux</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
