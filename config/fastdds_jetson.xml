<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>

    <transport_descriptor>
      <transport_id>udp_lan</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>      <!-- 16 MB -->
      <receiveBufferSize>16777216</receiveBufferSize> <!-- 16 MB -->
      <interfaceWhiteList>
        <address>100.88.16.123</address>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
   
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size> <!-- 64 MB -->
    </transport_descriptor>
    
    <transport_descriptor>
      <transport_id>udp_loopback</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  
  </transport_descriptors>

  <participant profile_name="lan_peer" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp_lan</transport_id>
        <transport_id>udp_loopback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <!-- Announce discovery on this host's LAN IP so the PC replies here. -->
          <metatrafficUnicastLocatorList>
            <locator>
              <udpv4>
                <address>100.88.16.123</address>
              </udpv4>
            </locator>

          </metatrafficUnicastLocatorList>
        
        <!-- Unicast discovery to the PC (no multicast over WiFi). -->
        <initialPeersList>
          <locator>
            <udpv4>
              <address>100.88.16.124</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>

      </builtin>
    </rtps>
  </participant>
</profiles>
<!-- Jetson PUBLISHER. self=100.88.16.123  peer(PC)=100.88.16.124  (WiFi LAN, MTU 1500).
     REQUIRES Tailscale DOWN on both ends: LAN 100.88.x is inside Tailscale CGNAT
     100.64.0.0/10, so Tailscale anti-spoof DROPs these packets when it is up. -->
